# -----------------------------------------------------------------------------
# 本地环境变量模板
#
# 1. 复制本文件为 .env (.env 已被 .gitignore 忽略)
# 2. 根据自己的 Obsidian vault 路径修改 VAULT_PLUGIN_DIR
# -----------------------------------------------------------------------------

# 'make install' 的目标目录：把 main.js / styles.css / manifest.json 复制到这里。
# 支持以 ~ 开头的家目录路径。
# 示例：
#   VAULT_PLUGIN_DIR=~/SynologyDrive/AppDataSync/obsidian/.obsidian/plugins/external-file-embed-and-link
VAULT_PLUGIN_DIR=
